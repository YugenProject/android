<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!--
    Yugen forks. Repo names are unchanged; only the remote differs so that
    `repo forall` and patch scripts keep working unchanged.
  -->

  <!-- The Clover Project (GitLab): Pixel GMS payload and Pixel apps -->
  <project path="vendor/pixel/gms" name="vendor_pixel_gms_17" remote="clover"
           revision="17" clone-depth="1" />
  <project path="vendor/pixel/launcher" name="vendor_pixel_launcher" remote="clover"
           revision="17" clone-depth="1" />
  <project path="vendor/pixel/sounds" name="vendor_pixel_sounds" remote="clover"
           revision="17" clone-depth="1" />
  <project path="vendor/pixel/themepicker" name="vendor_pixel_themepicker" remote="clover"
           revision="17" clone-depth="1" />
  <project path="vendor/pixel/extract-utils" name="vendor_pixel_extract-utils" remote="clover"
           revision="17" />

  <!-- manifest itself, so the tree carries Yugen's copy -->
  <remove-project name="LineageOS/android" />
  <project path="android" name="android" remote="yugen" />

  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="yugen" />

  <remove-project name="LineageOS/android_lineage-sdk" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="yugen" />

  <remove-project name="LineageOS/android_packages_apps_Updater" />
  <project path="packages/apps/Updater" name="android_packages_apps_Updater" remote="yugen" />

  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="yugen" />

  <!-- Build banner says YUGEN_VERSION instead of LINEAGE_VERSION -->
  <remove-project name="LineageOS/android_build_soong" />
  <project path="build/soong" name="android_build_soong"
           groups="pdk,tradefed,sysui-studio" remote="yugen" />

  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings"
           groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="yugen" />

  <remove-project name="LineageOS/android_packages_apps_LineageParts" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="yugen" />

  <remove-project name="LineageOS/android_packages_apps_SetupWizard" />
  <project path="packages/apps/SetupWizard" name="android_packages_apps_SetupWizard" remote="yugen" />

  <remove-project name="LineageOS/android_packages_overlays_Lineage" />
  <project path="packages/overlays/Lineage" name="android_packages_overlays_Lineage" remote="yugen" />

  <remove-project name="LineageOS/android_packages_resources_devicesettings" />
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="yugen" />

  <remove-project name="LineageOS/android_system_sepolicy" />
  <project path="system/sepolicy" name="android_system_sepolicy" groups="pdk" remote="yugen" />

  <remove-project name="LineageOS/android_hardware_lineage_interfaces" />
  <project path="hardware/lineage/interfaces" name="android_hardware_lineage_interfaces" remote="yugen" />

  <!-- stock AOSP Launcher3 (android-17.0.0_r1) instead of the LineageOS launcher fork -->
  <remove-project name="LineageOS/android_packages_apps_Launcher3" />
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3"
           groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="yugen" />

  <!-- Evolution-X GMS prebuilts and product definitions -->
  <project path="vendor/gms" name="YugenProject/vendor_gms"
           revision="cnb" clone-depth="1" remote="github" />

</manifest>
